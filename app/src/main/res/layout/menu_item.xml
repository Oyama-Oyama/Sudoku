<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp12"
            android:gravity="left|center_vertical"
            android:text="title"
            android:textColor="@color/black"
            android:textSize="@dimen/sp18"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/star1"
            android:layout_width="@dimen/dp14"
            android:layout_height="@dimen/dp14"
            android:layout_marginLeft="@dimen/dp12"
            android:scaleType="centerInside"
            android:src="@mipmap/img_10"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title" />

        <ImageView
            android:id="@+id/star2"
            android:layout_width="@dimen/dp14"
            android:layout_height="@dimen/dp14"
            android:scaleType="centerInside"
            android:src="@mipmap/img_10"
            app:layout_constraintLeft_toRightOf="@id/star1"
            app:layout_constraintTop_toTopOf="@id/star1" />

        <ImageView
            android:id="@+id/star3"
            android:layout_width="@dimen/dp14"
            android:layout_height="@dimen/dp14"
            android:scaleType="centerInside"
            android:src="@mipmap/img_10"
            app:layout_constraintLeft_toRightOf="@id/star2"
            app:layout_constraintTop_toTopOf="@id/star1" />

        <ImageView
            android:id="@+id/star4"
            android:layout_width="@dimen/dp14"
            android:layout_height="@dimen/dp14"
            android:scaleType="centerInside"
            android:src="@mipmap/img_10"
            app:layout_constraintLeft_toRightOf="@id/star3"
            app:layout_constraintTop_toTopOf="@id/star1" />

        <ImageView
            android:id="@+id/star5"
            android:layout_width="@dimen/dp14"
            android:layout_height="@dimen/dp14"
            android:scaleType="centerInside"
            android:src="@mipmap/img_10"
            app:layout_constraintLeft_toRightOf="@id/star4"
            app:layout_constraintTop_toTopOf="@id/star1" />

        <TextView
            android:id="@+id/detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp12"
            android:layout_marginTop="@dimen/dp4"
            android:layout_marginRight="@dimen/dp12"
            android:gravity="top|left"
            android:minHeight="@dimen/dp72"
            android:paddingBottom="@dimen/dp6"
            android:text="111111111111111"
            android:textColor="@color/likeMain"
            android:textSize="@dimen/sp12"
            app:layout_constraintBottom_toTopOf="@id/action"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/star1" />

        <TextView
            android:id="@+id/action"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp36"
            android:background="@color/A4"
            android:gravity="center_vertical|right"
            android:paddingRight="@dimen/dp12"
            android:text="@string/startChallenge"
            android:textColor="@color/white"
            android:textSize="@dimen/sp14"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

        <TextView
            android:id="@+id/tag"
            android:gravity="center"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="@dimen/sp6"
            android:paddingTop="@dimen/dp6"
            android:textStyle="bold"
            android:layout_marginRight="@dimen/dp12"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>